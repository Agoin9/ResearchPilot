# DeepSeek API 配置模板
# 使用方法：复制本文件为 .env（在 backend 目录下），填入真实 Key。
# .env 已被 .gitignore 排除，不会提交到 git，也绝不会暴露给前端。

# DeepSeek API Key（在 https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# API 地址（默认官方地址，一般不用改）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型名称
DEEPSEEK_MODEL=deepseek-chat

# 请求超时秒数
DEEPSEEK_TIMEOUT=60

# 说明：不配置 DEEPSEEK_API_KEY（或留空）时，后端自动进入演示模式，
# 返回预设的示例科研计划，保证没有 Key 也能完整演示。
